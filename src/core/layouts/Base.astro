---
import { url } from '../lib/url';
import onestCyr from '../assets/fonts/onest-cyrillic.woff2';
import golosCyr from '../assets/fonts/golos-text-cyrillic.woff2';
import '../styles/global.css';
import content from '../../client/content.json';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown;
}

const { title, description, noindex = false, schema } = Astro.props;
const { clinic, contacts } = content;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const clinicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: clinic.nameFull,
  legalName: clinic.legalName,
  url: Astro.site?.href,
  telephone: contacts.phoneRaw,
  email: contacts.email,
  priceRange: '800–8900 ₽',
  medicalSpecialty: 'Diagnostic',
  availableService: {
    '@type': 'MedicalTest',
    name: 'Ультразвуковое исследование',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'RU',
    addressRegion: clinic.region,
    addressLocality: clinic.city,
    streetAddress: 'проспект Химиков, 42',
    postalCode: '423570',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: contacts.coords[0],
    longitude: contacts.coords[1],
  },
  openingHours: contacts.hoursSchema,
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={clinic.nameFull} />
    <meta name="theme-color" content="#EDF1F2" />

    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />

    <link
      rel="preload"
      href={onestCyr}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={golosCyr}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline set:html={JSON.stringify(clinicSchema)} type="application/ld+json" />
    {schema && <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />}

    {/* Версия для слабовидящих — применяем до отрисовки, чтобы не мигало */}
    <script is:inline>
      try {
        if (localStorage.getItem('ayaz-a11y') === '1') {
          document.documentElement.classList.add('a11y');
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Перейти к содержанию</a>
    <slot />

    <script>
      // ─── Появление секций при скролле: fade-up 16px, один раз ───
      const revealTargets = document.querySelectorAll('[data-reveal]');
      if (revealTargets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        revealTargets.forEach((el) => io.observe(el));
      }

      // ─── Счётчики: считаются вверх один раз ───
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (counters.length) {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const format = (n: number) => n.toLocaleString('ru-RU').replace(/,/g, ' ');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              io.unobserve(el);
              const target = Number(el.dataset.counter || 0);
              if (reduced) {
                el.textContent = format(target);
                continue;
              }
              const start = performance.now();
              const tick = (now: number) => {
                const p = Math.min((now - start) / 1200, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = format(Math.round(target * eased));
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            }
          },
          { threshold: 0.6 }
        );
        counters.forEach((el) => io.observe(el));
      }

      // ─── Переключатель «версия для слабовидящих» ───
      document.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((btn) => {
        const sync = () => {
          const on = document.documentElement.classList.contains('a11y');
          btn.setAttribute('aria-pressed', String(on));
        };
        sync();
        btn.addEventListener('click', () => {
          const on = document.documentElement.classList.toggle('a11y');
          try {
            localStorage.setItem('ayaz-a11y', on ? '1' : '0');
          } catch (e) {}
          document
            .querySelectorAll('[data-a11y-toggle]')
            .forEach((b) => b.setAttribute('aria-pressed', String(on)));
        });
      });
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 16px;
        top: -60px;
        z-index: 200;
        padding: 12px 20px;
        background: var(--ink);
        color: var(--paper);
        border-radius: var(--r-sm);
        font-size: var(--t-sm);
        transition: top var(--dur) var(--ease);
      }
      .skip-link:focus {
        top: 16px;
      }
    </style>
  </body>
</html>
