---
import { url } from '../lib/url';
import content from '../../client/content.json';
import ScanSector from './ScanSector.astro';

const { hero, clinic, contacts, services } = content;

// Три «быстрых» направления в hero — как список услуг в референсе
const quick = ['obp', 'pelvis', 'thyroid']
  .map((id) => services.find((s) => s.id === id)!)
  .filter(Boolean);

const fmt = (n: number) => n.toLocaleString('ru-RU').replace(/,/g, ' ');
---

<section class="hero">
  <div class="container">
    {/* ─── Верх: заголовок ─────────────────────────────────────── */}
    <div class="hero__head">
      <p class="hero__eyebrow eyebrow">{clinic.tagline} · {clinic.city}</p>

      <h1 class="hero__h1 t-display">
        {hero.h1.map((line, i) => (
          <span class="hero__line" style={`--line-delay: ${160 + i * 90}ms`}>
            <span>{line}</span>
          </span>
        ))}
      </h1>
    </div>

    {/* ─── Bento: фото-плитка + панель записи ──────────────────── */}
    <div class="hero__bento">
      {/* Крупная плитка: кадр из кабинета, поверх — чип, лид и CTA */}
      <div class="hero__stage">
        <div class="hero__media">
          <img
            src={url('/img/hero-room.webp')}
            alt="Врач ультразвуковой диагностики у аппарата Mindray DC-70 в кабинете центра «АЯЗ», Нижнекамск"
            width="1440"
            height="960"
            fetchpriority="high"
            decoding="async"
          />
          {/* Сектор-скан остаётся фирменным мотивом, но уже как тонкий слой
              поверх снимка, а не самостоятельный объект */}
          <div class="hero__scan decor" aria-hidden="true"><ScanSector /></div>
        </div>

        <div class="hero__stage-top">
          <span class="pill">
            <span class="hero__dot" aria-hidden="true"></span>
            Работаем сегодня до 20:00
          </span>
        </div>

        <div class="hero__stage-bottom">
          <p class="hero__lead">{hero.lead}</p>
          <div class="hero__cta">
            <button type="button" class="btn btn-primary" data-book-open>
              Записаться на исследование
            </button>
            <a href="#price" class="btn btn-ghost">Смотреть цены</a>
          </div>
        </div>
      </div>

      {/* Панель: слоты + быстрые услуги */}
      <aside class="hero__panel">
        <div class="hero__slots">
          <p class="hero__panel-label eyebrow">Ближайшая запись</p>
          <div class="hero__slots-list">
            {hero.slots.map((slot) => (
              <button
                type="button"
                class="hero__slot"
                data-slot={`${slot.label}, ${slot.time}`}
                data-goal="slot_click"
              >
                <span class="hero__slot-day">{slot.label}</span>
                <span class="hero__slot-time data">{slot.time}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="hero__quick">
          <p class="hero__panel-label eyebrow">Чаще всего записываются</p>
          <ul class="hero__quick-list">
            {quick.map((s) => (
              <li>
                <button type="button" class="hero__quick-item" data-book-open data-service={s.id}>
                  <span class="hero__quick-name">{s.name}</span>
                  <span class="hero__quick-price data">{fmt(s.price)} ₽</span>
                  <span class="arrow-btn hero__quick-arrow" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <a href="#services" class="hero__quick-all">
            Все исследования
            <span class="data">({services.length})</span>
          </a>
        </div>
      </aside>
    </div>

    {/* ─── Строка доверия ──────────────────────────────────────── */}
    <dl class="hero__trust">
      {hero.trust.map((item) => (
        <div class="hero__trust-cell">
          <dt class="hero__trust-label">{item.label}</dt>
          <dd class="hero__trust-value data">
            {item.counter ? <span data-counter={item.counter}>0</span> : item.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: 28px clamp(40px, 5vw, 64px);
  }

  /* ─── Заголовок ─── */
  .hero__eyebrow {
    opacity: 0;
    animation: hero-up 600ms var(--ease) 60ms forwards;
  }

  .hero__h1 {
    margin-top: 18px;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.02em;
  }

  .hero__line > span {
    display: block;
    transform: translateY(110%);
    animation: hero-line 900ms var(--ease) var(--line-delay) forwards;
  }

  .hero__line:nth-child(2) > span {
    color: var(--pulse);
  }

  @media (min-width: 900px) {
    .hero__line > span {
      white-space: nowrap;
    }
  }

  @keyframes hero-line {
    to {
      transform: none;
    }
  }

  @keyframes hero-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ─── Bento ─── */
  .hero__bento {
    display: grid;
    gap: var(--tile-gap);
    margin-top: clamp(28px, 3vw, 44px);
    opacity: 0;
    animation: hero-up 700ms var(--ease) 560ms forwards;
  }

  @media (min-width: 1000px) {
    .hero__bento {
      grid-template-columns: minmax(0, 1.62fr) minmax(320px, 1fr);
      align-items: stretch;
    }
  }

  /* Главная плитка */
  .hero__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: clamp(440px, 52vw, 560px);
    padding: 20px;
    border-radius: var(--r-lg);
    background: var(--ink);
    box-shadow: var(--shadow-tile);
    overflow: hidden;
    isolation: isolate;
  }

  @media (min-width: 700px) {
    .hero__stage {
      padding: 26px;
    }
  }

  /* Фото занимает всю плитку, текст ложится поверх */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  /* Мотив сектора — тонкой графикой поверх кадра, в правом верхнем углу */
  .hero__scan {
    position: absolute;
    top: -26%;
    right: -18%;
    width: min(76%, 420px);
    opacity: 0.5;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  @media (min-width: 700px) {
    .hero__scan {
      top: -22%;
      right: -6%;
      width: min(52%, 460px);
      opacity: 0.6;
    }
  }

  /* Кадр затягивается снизу, чтобы лид и кнопки читались поверх фото */
  .hero__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      to top,
      rgb(8 26 34 / 0.95) 0%,
      rgb(8 26 34 / 0.82) 34%,
      rgb(8 26 34 / 0.42) 62%,
      rgb(8 26 34 / 0.14) 100%
    );
    pointer-events: none;
  }

  /* На телефоне кадр занимает верх плитки, текст живёт на сплошной подложке —
     иначе лид ложится прямо на лицо врача */
  @media (max-width: 699px) {
    .hero__media {
      inset: 0 0 auto;
      height: 52%;
    }

    .hero__stage::after {
      background: linear-gradient(
        to top,
        var(--ink) 0%,
        var(--ink) 52%,
        rgb(8 26 34 / 0.55) 70%,
        rgb(8 26 34 / 0.1) 100%
      );
    }

    .hero__stage {
      min-height: 500px;
    }
  }

  @media (min-width: 700px) {
    .hero__stage::after {
      background: linear-gradient(
        to top,
        rgb(8 26 34 / 0.94) 0%,
        rgb(8 26 34 / 0.72) 40%,
        rgb(8 26 34 / 0.26) 72%,
        rgb(8 26 34 / 0.06) 100%
      );
    }
  }

  .hero__stage-top {
    position: relative;
    z-index: 1;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pulse);
    box-shadow: 0 0 0 3px rgb(13 122 114 / 0.18);
  }

  .hero__stage-bottom {
    position: relative;
    z-index: 1;
    max-width: 44ch;
  }

  .hero__lead {
    font-size: var(--t-lead);
    line-height: 1.45;
    color: color-mix(in oklab, #ffffff 82%, transparent);
  }

  .hero__stage .btn-ghost {
    border-color: color-mix(in oklab, #ffffff 34%, transparent);
    color: #fff;
  }

  .hero__stage .btn-ghost::before {
    background: #fff;
  }

  .hero__stage .btn-ghost:hover {
    color: var(--ink);
    border-color: #fff;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .hero__cta .btn {
    flex: 1 1 auto;
  }

  @media (min-width: 560px) {
    .hero__cta .btn {
      flex: 0 0 auto;
    }
  }

  /* ─── Боковая панель ─── */
  .hero__panel {
    display: grid;
    gap: var(--tile-gap);
    align-content: start;
  }

  @media (min-width: 640px) and (max-width: 999px) {
    .hero__panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .hero__panel {
      grid-template-rows: auto 1fr;
    }
  }

  .hero__slots,
  .hero__quick {
    padding: 22px;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
  }

  .hero__quick {
    display: flex;
    flex-direction: column;
  }

  .hero__panel-label {
    display: block;
    margin-bottom: 14px;
  }

  .hero__slots-list {
    display: flex;
    gap: 8px;
  }

  .hero__slot {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 12px 14px;
    border-radius: var(--r-sm);
    background: var(--paper);
    text-align: left;
    transition: background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .hero__slot:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .hero__slot-day {
    font-size: 0.6875rem;
    color: var(--ink-soft);
  }

  .hero__slot:hover .hero__slot-day {
    color: color-mix(in oklab, var(--paper) 72%, transparent);
  }

  .hero__slot-time {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  /* Быстрые услуги */
  .hero__quick-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__quick-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
  }

  .hero__quick-list li:last-child .hero__quick-item {
    border-bottom: 0;
  }

  .hero__quick-name {
    font-size: var(--t-sm);
    line-height: 1.3;
  }

  .hero__quick-price {
    font-size: var(--t-sm);
    font-weight: 500;
    white-space: nowrap;
  }

  .hero__quick-arrow {
    width: 34px;
    height: 34px;
    box-shadow: none;
    background: var(--paper);
  }

  .hero__quick-item:hover .hero__quick-arrow {
    background: var(--pulse);
    color: #fff;
  }

  .hero__quick-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 18px;
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--pulse);
  }

  .hero__quick-all .data {
    color: var(--ink-soft);
    font-weight: 400;
  }

  /* ─── Строка доверия ─── */
  .hero__trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tile-gap);
    margin: var(--tile-gap) 0 0;
    opacity: 0;
    animation: hero-up 700ms var(--ease) 760ms forwards;
  }

  @media (min-width: 860px) {
    .hero__trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hero__trust-cell {
    padding: 18px 20px;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
  }

  .hero__trust-label {
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .hero__trust-value {
    margin: 8px 0 0;
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.2;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__bento,
    .hero__trust,
    .hero__media img {
      opacity: 1;
    }
    .hero__line > span {
      transform: none;
      animation: none;
    }
  }
</style>
