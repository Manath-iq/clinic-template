---
import content from '../../client/content.json';
import SectionHead from './SectionHead.astro';

const { faq, contacts } = content;
---

<section class="section" id="faq">
  <div class="container">
    <SectionHead
      index="13"
      eyebrow="Вопросы"
      title="Что спрашивают чаще всего"
      lead="Не нашли свой вопрос — позвоните, администратор ответит без записи и обязательств."
    />

    <div class="faq">
      <div class="faq__list">
        {faq.map((item, i) => (
          <details class="faq__item" data-reveal style={`--reveal-delay: ${i * 40}ms`}>
            <summary class="faq__q">
              <span>{item.q}</span>
              <svg class="faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))}
      </div>

      <aside class="faq__aside card" data-reveal>
        <p class="eyebrow">Не нашли ответ</p>
        <p class="faq__aside-text">
          Позвоните — администратор подскажет, какое исследование нужно и как к нему подготовиться.
        </p>
        <a href={`tel:${contacts.phoneRaw}`} class="faq__phone data" data-goal="phone_click">
          {contacts.phone}
        </a>
        <p class="faq__hours t-xs">{contacts.hours}</p>
        <a
          href={`https://wa.me/${contacts.whatsapp}`}
          class="btn btn-ghost btn-sm faq__wa"
          data-goal="whatsapp_click"
          rel="noopener"
          target="_blank"
        >
          Написать в WhatsApp
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 960px) {
    .faq {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
      gap: 56px;
      align-items: start;
    }
  }

  .faq__list {
    border-top: 1px solid var(--hairline);
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 2px;
    cursor: pointer;
    list-style: none;
    font-size: var(--t-body);
    font-weight: 500;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--pulse);
  }

  .faq__icon {
    flex: none;
    margin-top: 2px;
    color: var(--ink-soft);
    transition: transform var(--dur) var(--ease);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    color: var(--pulse);
  }

  .faq__a {
    padding: 0 40px 24px 2px;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 68ch;
  }

  /* ─── Сайдбар ─── */
  .faq__aside {
    padding: 28px;
    position: sticky;
    top: 96px;
  }

  .faq__aside-text {
    margin-top: 14px;
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .faq__phone {
    display: inline-block;
    margin-top: 22px;
    font-size: 1.375rem;
    font-weight: 500;
  }

  .faq__hours {
    margin-top: 6px;
    color: var(--ink-soft);
  }

  .faq__wa {
    width: 100%;
    margin-top: 20px;
  }
</style>
