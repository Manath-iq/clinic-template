---
/**
 * Signature-элемент (п. 8.5): веерная развёртка области сканирования
 * УЗ-датчика. SVG-геометрия + canvas-развёртка, без библиотек и видео.
 *
 * Один проход при загрузке → амбиентная пульсация (opacity 0.04→0.08, 6с).
 * При prefers-reduced-motion остаётся статичным.
 */

// Геометрия сектора. Одни и те же числа кормят разметку, шкалу и canvas,
// чтобы дуги, засечки и подписи не разъезжались при правках.
const APEX = { x: 450, y: 60 };
const HALF = 0.505; // полураствор конуса от вертикали
const CONE = 'M450 60 L862 806 A470 470 0 0 1 38 806 Z';

// Дуги глубины: шаг 130 ед. = 4 см
const DEPTHS = [200, 330, 460, 590, 720];

// Левая кромка конуса — на ней живёт шкала. Правая закрыта объектом и
// уходит за край плитки, поэтому размечать её нечем.
const edge = { x: -Math.sin(HALF), y: Math.cos(HALF) };
const out = { x: -Math.cos(HALF), y: -Math.sin(HALF) }; // наружная нормаль к кромке

// Последняя дуга остаётся без подписи: на десктопе она приходится на зону,
// где плитку затягивает вуаль и начинается лид — цифра там налезала бы на текст.
const scale = DEPTHS.slice(0, 4).map((r, i) => {
  const px = APEX.x + edge.x * r;
  const py = APEX.y + edge.y * r;
  return {
    // Единица измерения — один раз, на первой засечке: повтор «см» у каждой
    // цифры читается как отладочный вывод, а не как шкала прибора.
    label: i === 0 ? '4 см' : String((i + 1) * 4),
    tick: { x1: px, y1: py, x2: px + out.x * 18, y2: py + out.y * 18 },
    left: ((px + out.x * 30) / 900) * 100,
    top: ((py + out.y * 30) / 900) * 100,
  };
});

// Радиальные линии сектора — от вершины до заведомо дальней точки, обрез по клипу
const rays = [-1, -0.5, 0, 0.5, 1].map((k) => {
  const a = k * HALF;
  return {
    x: APEX.x + Math.sin(a) * 1000,
    y: APEX.y + Math.cos(a) * 1000,
  };
});
---

<div class="scan" aria-hidden="true" data-scan>
  <canvas class="scan__canvas decor" data-scan-canvas width="900" height="900"></canvas>

  <svg class="scan__grid decor" viewBox="0 0 900 900" fill="none" role="presentation">
    <defs>
      <radialGradient id="scanFade" cx="50%" cy="6%" r="96%">
        <stop offset="0%" stop-color="var(--pulse-bright)" stop-opacity=".30" />
        <stop offset="30%" stop-color="var(--pulse-bright)" stop-opacity=".12" />
        <stop offset="70%" stop-color="var(--pulse-bright)" stop-opacity=".04" />
        <stop offset="100%" stop-color="var(--pulse-bright)" stop-opacity="0" />
      </radialGradient>
      <clipPath id="scanClip">
        <path d={CONE} />
      </clipPath>
    </defs>

    {/* Конус сканирования. vector-effect держит толщину линий равной
        волосяной линии интерфейса на любом размере: viewBox 900 ужимается
        до ~480 px, и обычный stroke-width 1 давал полупиксельную кашу. */}
    <path
      d={CONE}
      fill="url(#scanFade)"
      stroke="var(--pulse-bright)"
      stroke-opacity=".26"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />

    {/* Дуги глубины — шкала прибора */}
    <g
      clip-path="url(#scanClip)"
      stroke="var(--pulse-bright)"
      stroke-opacity=".22"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    >
      {DEPTHS.map((r) => <circle cx={APEX.x} cy={APEX.y} r={r} />)}
    </g>

    {/* Радиальные линии сектора — самый тихий слой, только чтобы задать объём */}
    <g
      clip-path="url(#scanClip)"
      stroke="var(--pulse-bright)"
      stroke-opacity=".14"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    >
      {rays.map((p) => <line x1={APEX.x} y1={APEX.y} x2={p.x} y2={p.y} />)}
    </g>

    {/* Засечки глубины на левой кромке — якорь для подписей */}
    <g
      class="scan__ticks"
      stroke="var(--pulse-bright)"
      stroke-opacity=".5"
      stroke-width="1.5"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    >
      {scale.map((m) => <line x1={m.tick.x1} y1={m.tick.y1} x2={m.tick.x2} y2={m.tick.y2} />)}
    </g>

    {/* Датчик */}
    <rect x="426" y="26" width="48" height="14" rx="3" fill="var(--pulse-bright)" fill-opacity=".65" />
    <rect x="437" y="8" width="26" height="22" rx="4" fill="var(--ink)" fill-opacity=".28" />
  </svg>

  {/* Подписи шкалы — обычный HTML, а не <text> внутри SVG: так они берут
      кегль и трекинг из тех же токенов, что и остальные микро-метки страницы,
      и не масштабируются вместе с viewBox до нечитаемых 8 px. */}
  <div class="scan__scale decor">
    {scale.map((m) => (
      <span class="scan__mark" style={`left:${m.left.toFixed(3)}%;top:${m.top.toFixed(3)}%`}>
        {m.label}
      </span>
    ))}
  </div>
</div>

<style>
  .scan {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    isolation: isolate;
  }

  .scan__grid,
  .scan__canvas,
  .scan__scale {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scan__grid {
    opacity: 0;
    animation: scan-in 1400ms var(--ease) 400ms forwards;
  }

  .scan__canvas {
    z-index: 1;
  }

  /* ─── Шкала глубины ─── */
  .scan__scale {
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    /* Проявляется после прохода развёртки — прибор сначала «видит», потом
       подписывает */
    animation: scan-in 700ms var(--ease) 2400ms forwards;
  }

  .scan__mark {
    position: absolute;
    /* Точка привязки — на кромке конуса, подпись висит слева от неё */
    transform: translate(-100%, -50%);
    font-family: var(--font-data);
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: color-mix(in oklab, var(--pulse) 62%, transparent);
  }

  /* На узких экранах развёртка уходит за край плитки и ужимается вдвое —
     микро-подписи там превращаются в сор */
  @media (max-width: 700px) {
    .scan__scale,
    .scan__ticks {
      display: none;
    }
  }

  @keyframes scan-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scan__grid,
    .scan__scale {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-scan]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-scan-canvas]');

  if (root && canvas) {
    const ctx = canvas.getContext('2d');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Геометрия сектора — та же, что у SVG-конуса в разметке выше:
    // вершина (450,60), кромки в (38,806) и (862,806), дуга r=470 с центром (450,580).
    const APEX = { x: 450, y: 60 };
    const ARC = { x: 450, y: 580, r: 470, a1: 0.502, a2: 2.639 };
    const HALF_ANGLE = 0.505; // полураствор конуса от вертикали
    const R_MIN = 60;
    const R_MAX = 990;

    // Ось Y в canvas смотрит вниз, поэтому «вниз» — это +π/2.
    // Развёртка идёт слева направо: от угла с отрицательным cos к положительному.
    const A_START = Math.PI / 2 + HALF_ANGLE; // левая кромка
    const A_END = Math.PI / 2 - HALF_ANGLE; // правая кромка

    // Область сканирования — спеклы за её пределы не выходят
    const clipSector = (ctx: CanvasRenderingContext2D) => {
      ctx.beginPath();
      ctx.moveTo(APEX.x, APEX.y);
      ctx.lineTo(862, 806);
      ctx.arc(ARC.x, ARC.y, ARC.r, ARC.a1, ARC.a2);
      ctx.closePath();
      ctx.clip();
    };

    // Стабильный псевдослучайный «спекл» — текстура B-режима
    let seed = 20260802;
    const rand = () => {
      seed = (seed * 1664525 + 1013904223) % 4294967296;
      return seed / 4294967296;
    };

    const specks = Array.from({ length: 620 }, () => {
      const a = A_START + rand() * (A_END - A_START);
      const r = R_MIN + Math.sqrt(rand()) * (R_MAX - R_MIN);
      return {
        a,
        r,
        size: 1.2 + rand() * 5,
        alpha: 0.18 + rand() * 0.62,
      };
    });

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const box = root.getBoundingClientRect();
      canvas.width = Math.round(box.width * dpr);
      canvas.height = Math.round(box.height * dpr);
    };

    const draw = (sweep: number, ambient: number) => {
      if (!ctx) return;
      const scale = canvas.width / 900;
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      ctx.clearRect(0, 0, 900, 900);

      const pulse = getComputedStyle(root).getPropertyValue('--pulse-bright').trim() || '#12958C';

      ctx.save();
      clipSector(ctx);

      // Спеклы проявляются по мере прохода развёртки
      for (const s of specks) {
        const t = (s.a - A_START) / (A_END - A_START);
        const revealed = sweep >= t ? 1 : Math.max(0, 1 - (t - sweep) * 14);
        if (revealed <= 0.01) continue;

        const x = APEX.x + Math.cos(s.a) * s.r;
        const y = APEX.y + Math.sin(s.a) * s.r;
        const depthFade = 1 - (s.r - R_MIN) / (R_MAX - R_MIN);

        ctx.globalAlpha = s.alpha * revealed * (0.25 + depthFade * 0.75) * ambient;
        ctx.fillStyle = pulse;
        ctx.beginPath();
        ctx.arc(x, y, s.size, 0, Math.PI * 2);
        ctx.fill();
      }

      // Линия развёртки — видна только во время прохода
      if (sweep > 0 && sweep < 1) {
        const a = A_START + sweep * (A_END - A_START);
        const grad = ctx.createLinearGradient(
          APEX.x,
          APEX.y,
          APEX.x + Math.cos(a) * R_MAX,
          APEX.y + Math.sin(a) * R_MAX
        );
        grad.addColorStop(0, pulse);
        grad.addColorStop(1, 'transparent');

        ctx.globalAlpha = 0.55;
        ctx.strokeStyle = grad;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(APEX.x, APEX.y);
        ctx.lineTo(APEX.x + Math.cos(a) * R_MAX, APEX.y + Math.sin(a) * R_MAX);
        ctx.stroke();
      }

      ctx.restore();
      ctx.globalAlpha = 1;
    };

    resize();
    addEventListener('resize', resize, { passive: true });

    if (reduced) {
      draw(1, 1);
    } else {
      const SWEEP_MS = 2200;
      const started = performance.now() + 500;

      const frame = (now: number) => {
        const elapsed = now - started;

        if (elapsed < SWEEP_MS) {
          const p = Math.max(0, elapsed / SWEEP_MS);
          draw(1 - Math.pow(1 - p, 3), 1);
          requestAnimationFrame(frame);
          return;
        }

        // Амбиентная пульсация: единственное, что движется бесконечно (п. 9)
        const phase = ((elapsed - SWEEP_MS) % 6000) / 6000;
        const ambient = 0.72 + 0.28 * Math.sin(phase * Math.PI * 2);
        draw(1, ambient);
        requestAnimationFrame(frame);
      };

      requestAnimationFrame(frame);
    }
  }
</script>
