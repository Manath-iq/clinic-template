---
import { url } from '../lib/url';
/** Cookie-баннер с возможностью отказаться от аналитических cookie (п. 3.3) */
---

<div class="cookie" data-cookie hidden>
  <div class="cookie__inner">
    <p class="cookie__text t-sm">
      Сайт использует технические cookie — без них он не работает. Аналитические cookie
      (Яндекс.Метрика) помогают понять, какие разделы читают, — от них можно отказаться.
      Подробнее в <a href={url("/privacy")}>Политике обработки персональных данных</a>.
    </p>
    <div class="cookie__actions">
      <button type="button" class="btn btn-sm btn-ghost" data-cookie-decline>
        Только необходимые
      </button>
      <button type="button" class="btn btn-sm btn-primary" data-cookie-accept>
        Принять все
      </button>
    </div>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 150;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cookie[data-visible] {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1079px) {
    .cookie {
      bottom: 88px;
    }
  }

  .cookie__inner {
    display: grid;
    gap: 18px;
    max-width: calc(var(--container) + 48px);
    margin-inline: auto;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-float);
  }

  @media (min-width: 860px) {
    .cookie__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 32px;
    }
  }

  .cookie__text {
    color: var(--ink-soft);
    line-height: 1.55;
    max-width: 84ch;
  }

  .cookie__text a {
    color: var(--pulse);
    border-bottom: 1px solid currentColor;
  }

  .cookie__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cookie__actions .btn {
    flex: 1 1 auto;
    white-space: nowrap;
  }
</style>

<script>
  const KEY = 'ayaz-cookie-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie]');

  if (banner) {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {}

    if (!stored) {
      banner.hidden = false;
      setTimeout(() => banner.setAttribute('data-visible', ''), 800);
    }

    const decide = (value: 'all' | 'necessary') => {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
      banner.removeAttribute('data-visible');
      setTimeout(() => {
        banner.hidden = true;
      }, 240);
      // Здесь на боевом проекте инициализируется Яндекс.Метрика при value === 'all'
    };

    banner
      .querySelector('[data-cookie-accept]')
      ?.addEventListener('click', () => decide('all'));
    banner
      .querySelector('[data-cookie-decline]')
      ?.addEventListener('click', () => decide('necessary'));
  }
</script>
