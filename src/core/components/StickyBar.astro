---
import content from '../../client/content.json';

const { contacts } = content;
---

{/* Появляется после 400px прокрутки, только на мобиле (п. 10) */}
<div class="sticky" data-sticky-bar>
  <a href={`tel:${contacts.phoneRaw}`} class="sticky__btn" data-goal="phone_click">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1.1 1A16 16 0 0 1 4 5.1 1 1 0 0 1 5 4Z" />
    </svg>
    Позвонить
  </a>

  <button type="button" class="sticky__btn sticky__btn--primary" data-book-open>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" />
    </svg>
    Записаться
  </button>

  <a
    href={`https://wa.me/${contacts.whatsapp}`}
    class="sticky__btn"
    target="_blank"
    rel="noopener"
    data-goal="whatsapp_click"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.7-5.2A8.5 8.5 0 1 1 21 11.5Z" />
    </svg>
    WhatsApp
  </a>
</div>

<style>
  .sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 8px;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--hairline);
    box-shadow: 0 -12px 32px -20px rgb(11 36 48 / 0.4);
    transform: translateY(110%);
    transition: transform var(--dur) var(--ease);
    padding-bottom: max(8px, env(safe-area-inset-bottom));
  }

  .sticky[data-visible] {
    transform: none;
  }

  @media (min-width: 1080px) {
    .sticky {
      display: none;
    }
  }

  .sticky__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 56px;
    border-radius: var(--r-sm);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--ink);
  }

  .sticky__btn--primary {
    background: var(--pulse);
    color: #fff;
  }

  .sticky__btn svg {
    flex: none;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  const footer = document.querySelector('footer');

  if (bar) {
    const onScroll = () => {
      const passed = scrollY > 400;
      // Не перекрываем футер
      const footerTop = footer?.getBoundingClientRect().top ?? Infinity;
      const overFooter = footerTop < innerHeight - 80;
      bar.toggleAttribute('data-visible', passed && !overFooter);
    };

    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
  }
</script>
