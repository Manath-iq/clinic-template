---
import { url } from '../lib/url';
import content from '../../client/content.json';
import SectionHead from './SectionHead.astro';

const { services, groups } = content;
const VISIBLE = 6;

const fmt = (n: number) => n.toLocaleString('ru-RU').replace(/,/g, ' ');

// Плитки-зоны: часть с фотографией, часть — фирменная градиентная поверхность
// Фото добавляются по мере готовности; без него плитка рисуется
// фирменной градиентной поверхностью со следом сектор-скана.
const photos = import.meta.glob('/public/img/zones/*.webp', { eager: true });
const hasPhoto = (id: string) => `/public/img/zones/${id}.webp` in photos;

const zones = [
  { id: 'abdomen', name: 'Живот и почки', span: 'wide' },
  { id: 'kids', name: 'Детям', span: 'normal' },
  { id: 'thyroid', name: 'Щитовидка и мягкие ткани', span: 'normal' },
  { id: 'heart', name: 'Сердце и сосуды', span: 'normal' },
  { id: 'women', name: 'Женское', span: 'wide' },
  { id: 'men', name: 'Мужское', span: 'normal' },
].map((z) => ({
  ...z,
  photo: hasPhoto(z.id) ? `/img/zones/${z.id}.webp` : null,
  // Плитки без фото держат содержанием, а не одной подписью
  hint: services
    .filter((s) => s.group === z.id)
    .slice(0, 3)
    .map((s) => {
      const short = s.name.replace(/ —.*/, '').replace(/ с .*/, '');
      return short.length > 26 ? short.slice(0, 24).trimEnd() + '…' : short;
    })
    .join(' · '),
}));

const countIn = (id: string) => services.filter((s) => s.group === id).length;
const minPriceIn = (id: string) =>
  Math.min(...services.filter((s) => s.group === id).map((s) => s.price));
---

<section class="section" id="services">
  <div class="container">
    <SectionHead
      index="02"
      eyebrow="Подбор исследования"
      title="Найдите своё исследование"
      lead="Выберите зону тела или введите название — например, «печень» или «щитовидка»."
    />

    {/* ─── Bento-плитки зон ─────────────────────────────────────── */}
    <div class="zones" data-reveal>
      {zones.map((z, i) => (
        <button
          type="button"
          class="tile zone"
          data-span={z.span}
          data-zone={z.id}
          data-photo={z.photo ? '' : undefined}
          style={`--reveal-delay: ${i * 50}ms`}
          aria-label={`Показать исследования: ${z.name}`}
        >
          {z.photo ? (
            <span class="tile__media">
              <img
                src={url(z.photo)}
                alt=""
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </span>
          ) : (
            /* Без фото плитку держит фирменный мотив сектора */
            <svg class="zone__glyph decor" viewBox="0 0 200 200" fill="none" aria-hidden="true">
              <path
                d="M100 6 L192 172 A104 104 0 0 1 8 172 Z"
                fill="var(--pulse-bright)"
                fill-opacity=".07"
                stroke="var(--pulse-bright)"
                stroke-opacity=".22"
              />
              <g stroke="var(--pulse-bright)" stroke-opacity=".16" fill="none">
                <path d="M62 96 A 44 44 0 0 0 138 96" />
                <path d="M40 136 A 76 76 0 0 0 160 136" />
                <path d="M20 172 A 108 108 0 0 0 180 172" />
              </g>
              <g fill="var(--pulse-bright)" fill-opacity=".28">
                <circle cx="86" cy="78" r="2.6" /><circle cx="118" cy="94" r="2" />
                <circle cx="70" cy="124" r="3" /><circle cx="132" cy="140" r="2.4" />
                <circle cx="100" cy="158" r="2.2" /><circle cx="52" cy="162" r="2.6" />
                <circle cx="150" cy="170" r="2" /><circle cx="104" cy="112" r="1.8" />
              </g>
            </svg>
          )}

          <span class="zone__top">
            <span class="pill zone__pill">{z.name}</span>
            {!z.photo && <span class="zone__hint">{z.hint}</span>}
          </span>

          <span class="zone__bottom">
            <span class="zone__meta">
              <span class="data">{countIn(z.id)}</span> исследований · от{' '}
              <span class="data">{fmt(minPriceIn(z.id))} ₽</span>
            </span>
            <span class="arrow-btn" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </span>
          </span>
        </button>
      ))}
    </div>

    {/* ─── Поиск и фильтры ──────────────────────────────────────── */}
    <div class="picker__controls" data-reveal>
      <div class="picker__search">
        <svg class="picker__search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <label class="sr-only" for="service-search">Поиск исследования</label>
        <input
          type="search"
          id="service-search"
          class="picker__input"
          placeholder="Печень, щитовидка, сосуды шеи…"
          autocomplete="off"
          data-picker-search
        />
        <button type="button" class="picker__clear" data-picker-clear hidden aria-label="Очистить поиск">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="scroll-x picker__filters" role="group" aria-label="Фильтр по зоне">
        {groups.map((g, i) => (
          <button type="button" class="chip" data-picker-filter={g.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {g.name}
          </button>
        ))}
      </div>
    </div>

    {/* ─── Карточки услуг ───────────────────────────────────────── */}
    <ul class="picker__list" data-picker-list>
      {services.map((s, i) => (
        <li
          class="picker__item"
          data-service-card
          data-group={s.group}
          data-name={`${s.name} ${s.note ?? ''}`.toLowerCase()}
          hidden={i >= VISIBLE}
          data-reveal={i < VISIBLE ? '' : undefined}
          style={i < VISIBLE ? `--reveal-delay: ${i * 50}ms` : undefined}
        >
          <article class="card card-hover picker__card">
            <div>
              <h3 class="picker__name">{s.name}</h3>
              {s.note && <p class="picker__note t-xs">{s.note}</p>}
            </div>

            <div class="picker__meta">
              <span class="picker__tag data">{s.duration} мин</span>
              {s.needsPrep ? (
                <a href="#prep" class="picker__tag picker__tag--prep">Нужна подготовка</a>
              ) : (
                <span class="picker__tag">Без подготовки</span>
              )}
            </div>

            <div class="picker__foot">
              <p class="picker__price data">{fmt(s.price)} <span>₽</span></p>
              <button
                type="button"
                class="arrow-btn arrow-btn--accent"
                data-book-open
                data-service={s.id}
                aria-label={`Записаться: ${s.name}`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </button>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <p class="picker__empty" data-picker-empty hidden>
      По запросу ничего не нашлось. Позвоните — администратор подскажет, какое исследование подойдёт.
    </p>

    <div class="picker__more">
      <button type="button" class="btn btn-ghost" data-picker-more>
        Показать все исследования
        <span class="data">({services.length})</span>
      </button>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ─── Плитки зон ─── */
  .zones {
    display: grid;
    gap: var(--tile-gap);
    margin-bottom: var(--tile-gap);
  }

  /* На телефоне плитки в одну колонку — крупные тач-зоны, ничего не режется */
  @media (min-width: 520px) {
    .zones {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 760px) {
    .zones {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(200px, auto);
    }
    .zone[data-span='wide'] {
      grid-column: span 2;
    }
  }

  .zone {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 200px;
    padding: 14px;
    text-align: left;
    color: var(--ink);
    /* Плитки без фото — фирменная поверхность, а не пустая карточка */
    background: linear-gradient(155deg, #ffffff 0%, #e7eeef 62%, #dbe6e8 100%);
  }

  @media (min-width: 760px) {
    .zone {
      padding: 16px;
    }
  }

  .zone[data-photo] {
    color: #fff;
  }

  .zone[data-photo] .zone__meta {
    color: color-mix(in oklab, #ffffff 82%, transparent);
  }

  .zone__glyph {
    position: absolute;
    right: -6%;
    bottom: -34%;
    width: 54%;
    max-width: 200px;
    opacity: 0.85;
    pointer-events: none;
  }

  .zone[data-span='wide'] .zone__glyph {
    width: 30%;
    right: 2%;
    bottom: -28%;
  }

  .zone__hint {
    display: block;
    margin-top: 12px;
    padding-left: 4px;
    max-width: 28ch;
    font-size: var(--t-xs);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .zone__top,
  .zone__bottom {
    position: relative;
    z-index: 1;
  }

  .zone__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .zone__pill {
    font-weight: 500;
    white-space: normal;
    max-width: 100%;
  }

  .zone__meta {
    font-size: var(--t-xs);
    line-height: 1.35;
    color: var(--ink-soft);
  }

  /* На телефоне подсказку прячем — плитка живёт названием и ценой */
  @media (max-width: 519px) {
    .zone__hint {
      display: none;
    }
    .zone {
      min-height: 168px;
    }
    .zone__meta {
      white-space: nowrap;
    }
  }

  /* ─── Управление ─── */
  .picker__controls {
    display: grid;
    gap: 12px;
    margin-bottom: 20px;
  }

  @media (min-width: 900px) {
    .picker__controls {
      grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
      align-items: center;
      gap: 20px;
    }
  }

  .picker__search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .picker__search-icon {
    position: absolute;
    left: 18px;
    color: var(--ink-soft);
    pointer-events: none;
  }

  .picker__input {
    width: 100%;
    min-height: 54px;
    padding: 0 46px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
    font: inherit;
    font-size: var(--t-sm);
    color: var(--ink);
    transition: box-shadow var(--dur-fast) var(--ease);
  }

  .picker__input::placeholder {
    color: var(--ink-soft);
  }

  .picker__input:focus {
    box-shadow: var(--shadow-lift);
  }

  .picker__input::-webkit-search-cancel-button {
    display: none;
  }

  .picker__clear {
    position: absolute;
    right: 14px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--ink-soft);
    border-radius: 50%;
  }

  .picker__clear:hover {
    color: var(--ink);
  }

  .picker__filters {
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block: 4px;
  }

  @media (min-width: 900px) {
    .picker__filters {
      margin-inline: 0;
      padding-inline: 0;
      flex-wrap: wrap;
    }
  }

  /* ─── Список ─── */
  .picker__list {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .picker__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .picker__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .picker__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 22px;
  }

  .picker__name {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .picker__note {
    margin-top: 8px;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .picker__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .picker__tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: var(--paper);
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }

  .picker__tag--prep {
    background: var(--pulse-dim);
    color: var(--pulse-deep);
  }

  .picker__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
  }

  .picker__price {
    font-size: 1.375rem;
    font-weight: 500;
  }

  .picker__price span {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .picker__empty {
    padding: 48px 0;
    text-align: center;
    color: var(--ink-soft);
    font-size: var(--t-sm);
  }

  .picker__more {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  .picker__more .btn span {
    color: var(--ink-soft);
    font-size: var(--t-xs);
  }

  .picker__more .btn:hover span {
    color: inherit;
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-picker-list]');
  const search = document.querySelector<HTMLInputElement>('[data-picker-search]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-picker-clear]');
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-picker-more]');
  const empty = document.querySelector<HTMLElement>('[data-picker-empty]');
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-picker-filter]');
  const zoneTiles = document.querySelectorAll<HTMLButtonElement>('[data-zone]');

  if (list && search && moreBtn && empty) {
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-service-card]'));
    const LIMIT = 6;
    let group = 'all';
    let expanded = false;
    let firstRun = true;

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      const limited = !expanded && !q && group === 'all';
      let shown = 0;

      for (const card of cards) {
        const matchGroup = group === 'all' || card.dataset.group === group;
        const matchQuery = !q || (card.dataset.name || '').includes(q);
        const match = matchGroup && matchQuery;

        if (match && (!limited || shown < LIMIT)) {
          card.hidden = false;
          shown++;
          if (!firstRun) card.classList.add('is-visible');
        } else {
          card.hidden = true;
        }
      }

      const total = cards.filter((c) => {
        const mg = group === 'all' || c.dataset.group === group;
        const mq = !q || (c.dataset.name || '').includes(q);
        return mg && mq;
      }).length;

      empty.hidden = total > 0;
      moreBtn.parentElement!.hidden = !limited || total <= LIMIT;
      clearBtn!.hidden = !search.value;

      // Подсветка активной зоны и чипа
      filters.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.pickerFilter === group))
      );
      zoneTiles.forEach((t) =>
        t.toggleAttribute('data-active', t.dataset.zone === group)
      );

      firstRun = false;
    };

    const setGroup = (id: string) => {
      group = id;
      apply();
    };

    search.addEventListener('input', apply);

    clearBtn?.addEventListener('click', () => {
      search.value = '';
      search.focus();
      apply();
    });

    filters.forEach((btn) =>
      btn.addEventListener('click', () => setGroup(btn.dataset.pickerFilter || 'all'))
    );

    // Клик по плитке зоны фильтрует список и подскроллит к нему
    zoneTiles.forEach((tile) =>
      tile.addEventListener('click', () => {
        const id = tile.dataset.zone!;
        setGroup(group === id ? 'all' : id);
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
    );

    moreBtn.addEventListener('click', () => {
      expanded = true;
      apply();
    });

    apply();
  }
</script>
