---
/**
 * Эхо мотива скана (п. 8.5): одна и та же кривая, разная амплитуда.
 * Больше нигде мотив не повторяется.
 */
interface Props {
  amplitude?: number;
  dark?: boolean;
}

const { amplitude = 1, dark = false } = Astro.props;
const a = 8 * amplitude;
const mid = 16;

const d = `M0 ${mid} q60 -${a} 120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0 t120 0`;
---

<div class="wave" data-dark={dark || undefined} aria-hidden="true">
  <svg viewBox="0 0 1200 32" preserveAspectRatio="none" fill="none">
    <path d={d} stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<style>
  .wave {
    color: var(--hairline);
    overflow: hidden;
  }

  .wave[data-dark] {
    color: color-mix(in oklab, #ffffff 18%, transparent);
  }

  .wave svg {
    width: 100%;
    height: 32px;
    display: block;
  }
</style>
