---
import { url } from '../lib/url';
import content from '../../client/content.json';
import SectionHead from './SectionHead.astro';

const { visit } = content;
---

<section class="section" id="visit">
  <div class="container">
    <SectionHead
      index="07"
      eyebrow="Как проходит визит"
      title="От записи до протокола — один визит"
      lead="Четыре шага, ничего не растянуто на несколько дней. Результат вы забираете с собой в тот же день."
    />

    <figure class="visit__photo" data-reveal>
      <img
        src={url("/img/reception.webp")}
        alt="Ресепшен и зона ожидания центра ультразвуковой диагностики «АЯЗ» в Нижнекамске"
        width="1400"
        height="933"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <ol class="visit">
      {visit.map((v, i) => (
        <li
          class="visit__step"
          data-accent={v.accent || undefined}
          data-reveal
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <span class="visit__num data">{v.step}</span>
          <h3 class="visit__title">{v.title}</h3>
          <p class="visit__text">{v.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .visit__photo {
    margin: 0 0 var(--tile-gap);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-tile);
  }

  .visit__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 8;
    object-fit: cover;
    object-position: center 58%;
  }

  .visit {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .visit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .visit {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .visit__step {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-tile);
    padding: 28px 26px 32px;
  }

  /* Шаг 4 — то, ради чего люди выбирают центр */
  .visit__step[data-accent] {
    background: var(--ink);
    color: var(--paper);
  }

  .visit__num {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--pulse);
    padding-bottom: 24px;
  }

  .visit__step[data-accent] .visit__num {
    color: color-mix(in oklab, var(--pulse) 55%, #fff);
  }

  .visit__title {
    font-size: 1.3125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .visit__text {
    margin-top: 12px;
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .visit__step[data-accent] .visit__text {
    color: color-mix(in oklab, var(--paper) 70%, transparent);
  }
</style>
