---
import content from '../../client/content.json';
import BookingForm from './BookingForm.astro';

const { contacts, clinic } = content;

// Подписи на схеме проезда — из content.json, а не из разметки: смена бренда
// не должна требовать правки компонента (см. /src/client/theme.css).
// «г. Нижнекамск, проспект Химиков, 42» → улица «проспект Химиков» и дом «42».
const addressParts = contacts.address.split(',').map((s) => s.trim());
const mapStreet = addressParts.at(-2) ?? contacts.addressShort;
const mapHouse = addressParts.at(-1) ?? '';
---

<section class="section book" id="contacts">
  <div class="container">
    <div class="book__grid">
      {/* Форма */}
      <div class="book__form-wrap" data-reveal>
        <p class="section-index">
          <span>14</span>
          <span>Запись</span>
        </p>
        <h2 class="t-h2">Запишитесь на удобное время</h2>
        <p class="t-lead book__lead">{content.form.lead}</p>

        <BookingForm id="page" />
      </div>

      {/* Контакты и карта */}
      <div class="book__info" data-reveal>
        <dl class="book__facts">
          <div>
            <dt>Адрес</dt>
            <dd>{contacts.address}</dd>
          </div>
          <div>
            <dt>Телефон</dt>
            <dd>
              <a href={`tel:${contacts.phoneRaw}`} class="data book__phone" data-goal="phone_click">
                {contacts.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt>Часы работы</dt>
            <dd class="data">{contacts.hours}</dd>
          </div>
          <div>
            <dt>Парковка</dt>
            <dd>{contacts.parking}</dd>
          </div>
          <div>
            <dt>Как добраться</dt>
            <dd>{contacts.howToGet}</dd>
          </div>
        </dl>

        {/* Карта: статичная схема, интерактивная — по клику (п. 10) */}
        <figure class="book__map" data-map>
          <div class="book__map-frame">
            <svg class="book__map-static decor" viewBox="0 0 600 340" role="img" aria-label={`Схема расположения: ${contacts.address}`}>
              <rect width="600" height="340" fill="var(--map-bg)" />
              <g stroke="var(--map-road)" stroke-width="10" fill="none">
                <path d="M-10 118 H610" />
                <path d="M-10 250 H610" />
                <path d="M148 -10 V350" />
                <path d="M420 -10 V350" />
              </g>
              <g stroke="var(--map-lane)" stroke-width="4" fill="none">
                <path d="M-10 60 H610" /><path d="M-10 186 H610" /><path d="M-10 310 H610" />
                <path d="M60 -10 V350" /><path d="M270 -10 V350" /><path d="M520 -10 V350" />
              </g>
              <g fill="var(--map-block)">
                <rect x="176" y="30" width="70" height="60" rx="6" />
                <rect x="300" y="146" width="86" height="70" rx="6" />
                <rect x="452" y="46" width="64" height="52" rx="6" />
                <rect x="86" y="270" width="52" height="46" rx="6" />
              </g>

              {/* Метка центра */}
              <g transform="translate(276,196)">
                <circle r="26" fill="var(--pulse-bright)" fill-opacity=".16" />
                <circle r="13" fill="var(--pulse-bright)" />
                <circle r="4.5" fill="#fff" />
              </g>
            </svg>

            {/* Подписи — обычный HTML поверх схемы: берут шрифт и кегль из
                токенов и говорят тем же языком «стеклянных» чипов, что и
                остальные метки поверх изображений */}
            <span class="book__map-street eyebrow decor">{mapStreet}</span>
            {/* Метка называет здание, подпись выше — улицу: повторять название
                проспекта дважды на схеме 600×340 незачем */}
            <span class="pill book__map-pin decor">
              <span class="book__map-pin-dot" aria-hidden="true"></span>
              {clinic.name} · д. {mapHouse}
            </span>
          </div>

          <figcaption class="book__map-actions">
            <a
              href={contacts.mapUrl}
              class="btn btn-ghost btn-sm"
              target="_blank"
              rel="noopener"
            >
              Открыть в Яндекс.Картах
            </a>
            <span class="t-xs book__map-note">
              Интерактивная карта грузится по клику — экономит трафик
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .book {
    background: var(--surface);
    border-top: 1px solid var(--hairline);
  }

  .book__grid {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 960px) {
    .book__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }
  }

  .book__lead {
    margin-top: 18px;
    max-width: 48ch;
  }

  .book__form-wrap :global(.bform) {
    margin-top: 32px;
  }

  /* ─── Контакты ─── */
  .book__facts {
    display: grid;
    gap: 20px;
    margin: 0;
    padding-bottom: 32px;
  }

  @media (min-width: 600px) {
    .book__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 32px;
    }
    .book__facts div:nth-child(5) {
      grid-column: span 2;
    }
  }

  .book__facts dt {
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .book__facts dd {
    margin: 7px 0 0;
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  .book__phone {
    font-size: 1.25rem;
    font-weight: 500;
  }

  /* ─── Карта ─── */
  .book__map {
    /* Тона схемы держим здесь, а не в разметке: подмена бренда в
       /src/client/theme.css не должна упираться в захардкоженные хексы */
    --map-bg: color-mix(in oklab, var(--paper) 88%, var(--ink) 4%);
    --map-road: color-mix(in oklab, var(--map-bg) 82%, var(--ink) 12%);
    --map-lane: color-mix(in oklab, var(--map-bg) 90%, var(--ink) 6%);
    --map-block: color-mix(in oklab, var(--map-bg) 86%, var(--ink) 7%);

    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-tile);
  }

  .book__map-frame {
    position: relative;
  }

  .book__map-static {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 600 / 340;
  }

  /* Улица — микро-метка тем же кеглем и трекингом, что и .eyebrow страницы */
  .book__map-street {
    position: absolute;
    left: 4%;
    top: 28.5%;
    transform: translateY(-50%);
    font-size: 0.625rem;
    color: color-mix(in oklab, var(--ink) 42%, transparent);
    white-space: nowrap;
    pointer-events: none;
  }

  /* Метка центра — тот же стеклянный чип, что и поверх фото-плиток */
  .book__map-pin {
    position: absolute;
    left: 46%;
    top: 57.6%;
    /* Ниже ореола метки (r=26 ед.), чтобы чип не срезал ему низ */
    margin-top: 34px;
    transform: translateX(-50%);
    min-height: 34px;
    padding: 0 14px;
    box-shadow: 0 4px 14px -6px rgb(11 36 48 / 0.35);
    pointer-events: none;
  }

  .book__map-pin-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pulse);
  }

  .book__map-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 18px 20px;
    background: var(--surface);
  }

  .book__map-note {
    flex: 1 1 180px;
    color: var(--ink-soft);
    line-height: 1.4;
  }
</style>
