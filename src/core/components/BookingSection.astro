---
import content from '../../client/content.json';
import BookingForm from './BookingForm.astro';

const { contacts, clinic } = content;
---

<section class="section book" id="contacts">
  <div class="container">
    <div class="book__grid">
      {/* Форма */}
      <div class="book__form-wrap" data-reveal>
        <p class="section-index">
          <span>14</span>
          <span>Запись</span>
        </p>
        <h2 class="t-h2">Запишитесь на удобное время</h2>
        <p class="t-lead book__lead">{content.form.lead}</p>

        <BookingForm id="page" />
      </div>

      {/* Контакты и карта */}
      <div class="book__info" data-reveal>
        <dl class="book__facts">
          <div>
            <dt>Адрес</dt>
            <dd>{contacts.address}</dd>
          </div>
          <div>
            <dt>Телефон</dt>
            <dd>
              <a href={`tel:${contacts.phoneRaw}`} class="data book__phone" data-goal="phone_click">
                {contacts.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt>Часы работы</dt>
            <dd class="data">{contacts.hours}</dd>
          </div>
          <div>
            <dt>Парковка</dt>
            <dd>{contacts.parking}</dd>
          </div>
          <div>
            <dt>Как добраться</dt>
            <dd>{contacts.howToGet}</dd>
          </div>
        </dl>

        {/* Карта: статичная схема, интерактивная — по клику (п. 10) */}
        <figure class="book__map" data-map>
          <svg class="book__map-static decor" viewBox="0 0 600 340" role="img" aria-label={`Схема расположения: ${contacts.address}`}>
            <rect width="600" height="340" fill="#E3EAEB" />
            <g stroke="#CBD8DA" stroke-width="10" fill="none">
              <path d="M-10 118 H610" />
              <path d="M-10 250 H610" />
              <path d="M148 -10 V350" />
              <path d="M420 -10 V350" />
            </g>
            <g stroke="#D6E1E3" stroke-width="4" fill="none">
              <path d="M-10 60 H610" /><path d="M-10 186 H610" /><path d="M-10 310 H610" />
              <path d="M60 -10 V350" /><path d="M270 -10 V350" /><path d="M520 -10 V350" />
            </g>
            <g fill="#D9E3E4">
              <rect x="176" y="30" width="70" height="60" rx="3" />
              <rect x="300" y="146" width="86" height="70" rx="3" />
              <rect x="452" y="46" width="64" height="52" rx="3" />
              <rect x="86" y="270" width="52" height="46" rx="3" />
            </g>
            <text x="24" y="106" font-family="JetBrains Mono, monospace" font-size="11" fill="#8AA0A6" letter-spacing="1">ПРОСПЕКТ ХИМИКОВ</text>

            {/* Метка центра */}
            <g transform="translate(276,196)">
              <circle r="26" fill="#12958C" fill-opacity=".16" />
              <circle r="13" fill="#12958C" />
              <circle r="4.5" fill="#fff" />
            </g>
            <text x="300" y="240" font-family="Golos Text, sans-serif" font-size="14" font-weight="600" fill="#0B2430">АЯЗ · д. 42</text>
          </svg>

          <figcaption class="book__map-actions">
            <a
              href={contacts.mapUrl}
              class="btn btn-ghost btn-sm"
              target="_blank"
              rel="noopener"
            >
              Открыть в Яндекс.Картах
            </a>
            <span class="t-xs book__map-note">
              Интерактивная карта грузится по клику — экономит трафик
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .book {
    background: var(--surface);
    border-top: 1px solid var(--hairline);
  }

  .book__grid {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 960px) {
    .book__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }
  }

  .book__lead {
    margin-top: 18px;
    max-width: 48ch;
  }

  .book__form-wrap :global(.bform) {
    margin-top: 32px;
  }

  /* ─── Контакты ─── */
  .book__facts {
    display: grid;
    gap: 20px;
    margin: 0;
    padding-bottom: 32px;
  }

  @media (min-width: 600px) {
    .book__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 32px;
    }
    .book__facts div:nth-child(5) {
      grid-column: span 2;
    }
  }

  .book__facts dt {
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .book__facts dd {
    margin: 7px 0 0;
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  .book__phone {
    font-size: 1.25rem;
    font-weight: 500;
  }

  /* ─── Карта ─── */
  .book__map {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .book__map-static {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 600 / 340;
  }

  .book__map-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 18px 20px;
    border-top: 1px solid var(--hairline);
    background: var(--paper);
  }

  .book__map-note {
    flex: 1 1 180px;
    color: var(--ink-soft);
    line-height: 1.4;
  }
</style>
