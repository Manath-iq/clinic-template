---
import { url } from '../lib/url';
import content from '../../client/content.json';
import WaveDivider from './WaveDivider.astro';

const { clinic, contacts, legal, nav } = content;
const year = 2026;
---

<footer class="ftr dark-section">
  <WaveDivider dark amplitude={1.4} />

  <div class="container ftr__inner">
    {/* Предупреждение — постоянно на виду (ФЗ-38, ст. 24) */}
    <p class="ftr__warning">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 9v4M12 17h.01" /><circle cx="12" cy="12" r="9" />
      </svg>
      {legal.warning}
    </p>

    <div class="ftr__grid">
      <div class="ftr__brand">
        <p class="ftr__name">{clinic.name}</p>
        <p class="ftr__tagline t-xs">{clinic.nameFull}</p>
        <a href={`tel:${contacts.phoneRaw}`} class="ftr__phone data" data-goal="phone_click">
          {contacts.phone}
        </a>
        <p class="ftr__hours t-xs">{contacts.hours}</p>
        <div class="ftr__messengers">
          <a href={`https://wa.me/${contacts.whatsapp}`} target="_blank" rel="noopener" data-goal="whatsapp_click">WhatsApp</a>
          <a href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener">Telegram</a>
          <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
        </div>
      </div>

      <nav class="ftr__col" aria-label="Разделы сайта">
        <p class="ftr__col-title eyebrow">Разделы</p>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={url("/price")}>Полный прайс</a></li>
        </ul>
      </nav>

      <div class="ftr__col">
        <p class="ftr__col-title eyebrow">Документы</p>
        <ul>
          <li><a href={url("/license")}>Лицензия и реквизиты</a></li>
          <li><a href={url("/privacy")}>Политика обработки ПДн</a></li>
          <li><button type="button" data-license-open>Скан лицензии</button></li>
        </ul>
      </div>

      <div class="ftr__col">
        <p class="ftr__col-title eyebrow">Стандарты помощи</p>
        <ul>
          {legal.standards.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener nofollow">{s.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Реквизиты юрлица — ПП РФ № 736 */}
    <dl class="ftr__legal">
      <div>
        <dt>Юридическое лицо</dt>
        <dd>{clinic.legalName}</dd>
      </div>
      <div>
        <dt>ИНН / ОГРН</dt>
        <dd class="data">{clinic.inn} / {clinic.ogrn}</dd>
      </div>
      <div>
        <dt>Юридический адрес</dt>
        <dd>{clinic.legalAddress}</dd>
      </div>
      <div>
        <dt>Лицензия</dt>
        <dd class="data">
          № {clinic.license.number} от {clinic.license.date}
        </dd>
      </div>
    </dl>

    <p class="ftr__claims t-xs">{legal.claims}</p>

    <div class="ftr__bottom">
      <p class="t-xs">{legal.offer}</p>
      <p class="t-xs ftr__demo">{legal.demo}</p>
      <p class="t-xs ftr__copy data">© {year} {clinic.legalName}</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-bottom: 40px;
  }

  .ftr__inner {
    padding-top: 56px;
  }

  /* ─── Предупреждение ─── */
  .ftr__warning {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 22px;
    margin-bottom: 56px;
    background: color-mix(in oklab, #ffffff 8%, transparent);
    border-radius: var(--r-pill);
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .ftr__warning svg {
    flex: none;
    color: var(--pulse);
  }

  /* ─── Сетка ─── */
  .ftr__grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 700px) {
    .ftr__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .ftr__grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
      gap: 48px;
    }
  }

  .ftr__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .ftr__tagline {
    margin-top: 6px;
    color: color-mix(in oklab, var(--paper) 55%, transparent);
  }

  .ftr__phone {
    display: inline-block;
    margin-top: 24px;
    font-size: 1.375rem;
    font-weight: 500;
  }

  .ftr__hours {
    margin-top: 6px;
    color: color-mix(in oklab, var(--paper) 60%, transparent);
  }

  .ftr__messengers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 22px;
    font-size: var(--t-sm);
  }

  .ftr__messengers a {
    color: color-mix(in oklab, var(--paper) 78%, transparent);
    border-bottom: 1px solid color-mix(in oklab, #fff 22%, transparent);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .ftr__messengers a:hover {
    color: var(--paper);
    border-bottom-color: var(--pulse);
  }

  .ftr__col ul {
    display: grid;
    gap: 11px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .ftr__col a,
  .ftr__col button {
    font-size: var(--t-sm);
    color: color-mix(in oklab, var(--paper) 68%, transparent);
    text-align: left;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease);
  }

  .ftr__col a:hover,
  .ftr__col button:hover {
    color: var(--paper);
  }

  /* ─── Реквизиты ─── */
  .ftr__legal {
    display: grid;
    gap: 24px;
    margin: 56px 0 0;
    padding-top: 36px;
    border-top: 1px solid color-mix(in oklab, #fff 16%, transparent);
  }

  @media (min-width: 700px) {
    .ftr__legal {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 48px;
    }
  }

  @media (min-width: 1080px) {
    .ftr__legal {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ftr__legal dt {
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--paper) 50%, transparent);
  }

  .ftr__legal dd {
    margin: 8px 0 0;
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  .ftr__claims {
    margin-top: 32px;
    max-width: 88ch;
    color: color-mix(in oklab, var(--paper) 55%, transparent);
    line-height: 1.5;
  }

  /* ─── Низ ─── */
  .ftr__bottom {
    display: grid;
    gap: 12px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid color-mix(in oklab, #fff 16%, transparent);
    color: color-mix(in oklab, var(--paper) 48%, transparent);
    line-height: 1.5;
  }

  @media (min-width: 1080px) {
    .ftr__bottom {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.4fr) auto;
      gap: 40px;
      align-items: start;
    }
  }

  .ftr__demo {
    color: color-mix(in oklab, var(--paper) 60%, transparent);
  }
</style>
