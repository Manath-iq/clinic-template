---
import { url } from '../lib/url';
import content from '../../client/content.json';
import SectionHead from './SectionHead.astro';

const { doctors } = content;
---

<section class="section" id="doctors">
  <div class="container">
    <SectionHead
      index="06"
      eyebrow="Врачи"
      title="Кто проводит исследование"
      lead="Образование, категория и стаж каждого врача — как требует постановление о платных медуслугах. Врача можно выбрать при записи."
    />

    <ul class="docs">
      {doctors.map((d, i) => (
        <li class="docs__item" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <article class="docs__card">
            {/* Фото-плитка с подписью поверх — как в референсах */}
            <div class="tile docs__photo">
              <span class="tile__media">
                <img
                  src={url(d.photo)}
                  alt={`${d.nameFull} — ${d.position.toLowerCase()}, центр «АЯЗ», Нижнекамск`}
                  width="800"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </span>

              <span class="docs__photo-top">
                <span class="pill docs__exp">
                  <span class="data">{d.experience}</span> лет стажа
                </span>
              </span>

              <span class="docs__photo-bottom">
                <span class="docs__overlay">
                  <span class="docs__name">{d.nameFull}</span>
                  <span class="docs__position">{d.position}</span>
                </span>
                <button
                  type="button"
                  class="arrow-btn"
                  data-book-open
                  data-doctor={d.id}
                  aria-label={`Записаться к врачу: ${d.nameFull}`}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </button>
              </span>
            </div>

            {/* Квалификация — обязательна по ПП 736 */}
            <dl class="docs__facts">
              <div>
                <dt>Категория</dt>
                <dd>{d.category}</dd>
              </div>
              <div>
                <dt>Образование</dt>
                <dd>{d.education}</dd>
              </div>
              <div>
                <dt>Специализация</dt>
                <dd>{d.focus}</dd>
              </div>
            </dl>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .docs {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 620px) {
    .docs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .docs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .docs__card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ─── Фото ─── */
  .docs__photo {
    display: flex;
    flex: none; /* иначе flex-контейнер карточки схлопывает aspect-ratio */
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    aspect-ratio: 4 / 5;
    padding: 14px;
  }

  .docs__photo .tile__media img {
    object-position: center 22%;
  }

  .docs__photo-top,
  .docs__photo-bottom {
    position: relative;
    z-index: 1;
  }

  .docs__photo-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .docs__exp {
    gap: 5px;
  }

  .docs__exp .data {
    font-size: 1rem;
    font-weight: 500;
  }

  .docs__overlay {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #fff;
    min-width: 0;
  }

  .docs__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .docs__position {
    font-size: var(--t-xs);
    line-height: 1.3;
    color: color-mix(in oklab, #ffffff 80%, transparent);
  }

  /* ─── Квалификация ─── */
  .docs__facts {
    display: grid;
    gap: 12px;
    margin: 16px 0 0;
    padding: 18px 20px;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
    flex: 1;
    align-content: start;
  }

  .docs__facts dt {
    font-family: var(--font-data);
    font-size: 0.625rem;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .docs__facts dd {
    margin: 4px 0 0;
    font-size: var(--t-xs);
    line-height: 1.4;
  }
</style>
